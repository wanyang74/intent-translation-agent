{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/presentation/present_comparison.json",
  "title": "present_comparison: cars side by side",
  "type": "object",
  "properties": {
    "vehicleIds": {
      "type": "array",
      "items": {
        "$ref": "/schemas/common.json#/$defs/VehicleId",
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true
    },
    "attributes": {
      "type": "array",
      "items": {
        "enum": [
          "price",
          "estimatedTotal",
          "mileage",
          "year",
          "trim",
          "color",
          "delivery",
          "gapWaiver",
          "ownerRating"
        ],
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true
    }
  },
  "required": [
    "vehicleIds",
    "attributes"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "vehicleIds": [
        4812031,
        4773662
      ],
      "attributes": [
        "estimatedTotal",
        "mileage",
        "delivery"
      ]
    }
  ]
}
