{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/tools/get_delivery_dates.output.json",
  "title": "get_delivery_dates: output",
  "type": "object",
  "properties": {
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "$ref": "/schemas/common.json#/$defs/VehicleId"
          },
          "delivery": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "date": {
                    "$ref": "/schemas/common.json#/$defs/DateTime"
                  },
                  "location": {
                    "type": "string"
                  },
                  "routeId": {
                    "$ref": "/schemas/common.json#/$defs/RouteId"
                  }
                },
                "required": [
                  "text",
                  "date",
                  "location",
                  "routeId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "pickup": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "date": {
                    "$ref": "/schemas/common.json#/$defs/DateTime"
                  },
                  "location": {
                    "type": "string"
                  },
                  "routeId": {
                    "$ref": "/schemas/common.json#/$defs/RouteId"
                  }
                },
                "required": [
                  "text",
                  "date",
                  "location",
                  "routeId"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "vehicleId",
          "delivery",
          "pickup"
        ],
        "additionalProperties": false
      }
    },
    "nextStep": {
      "type": "string"
    }
  },
  "required": [
    "dates"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "dates": [
        {
          "vehicleId": 4812031,
          "delivery": {
            "text": "Saturday",
            "date": "2026-10-11T00:15:00Z",
            "location": "San Jose, CA",
            "routeId": "H4sIAAAAAAAEA6tWSk_NV7IyMrA0MzHRUcrJT1ayMjY21VFKTC5RsjLSUSpLgdAFRclKVtVKyTmZSlbGBoY6SgWVuUpWhrU6SilFuUpWxmY6SmWpRWAtycUlSlZKzo5KOkrJVQVKVkqWJiYGRkq1AEx5iiVsAAAA"
          },
          "pickup": null
        }
      ],
      "nextStep": "Quote only cars the user opens."
    }
  ]
}
