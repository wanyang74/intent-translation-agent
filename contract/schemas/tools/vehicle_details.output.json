{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/tools/vehicle_details.output.json",
  "title": "vehicle_details: output",
  "type": "object",
  "properties": {
    "vin": {
      "type": "string",
      "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "category",
          "names"
        ],
        "additionalProperties": false
      }
    },
    "imperfections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "$ref": "/schemas/common.json#/$defs/Fenced"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "vin",
    "features",
    "imperfections",
    "options",
    "packages",
    "highlights"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "vin": "EXAMPLEVN00000000",
      "features": [
        {
          "category": "Safety & Security",
          "names": [
            "Blind Spot Monitoring"
          ]
        }
      ],
      "imperfections": [
        {
          "title": "Paint",
          "description": "<untrusted source=\"carvana-vehicle\">Small area of paint damage.</untrusted>",
          "location": "exterior"
        }
      ],
      "options": [],
      "packages": [],
      "highlights": [
        "Long Range"
      ]
    }
  ]
}
