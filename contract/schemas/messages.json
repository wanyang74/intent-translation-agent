{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/messages.json",
  "title": "Messages between the client (core.js) and the agentic brain",
  "description": "Client messages are POSTed; server events stream back as newline-delimited JSON. Every message carries a trace ID.",
  "$defs": {
    "PageContext": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "pageType": {
          "enum": [
            "search",
            "vehicle",
            "other"
          ]
        },
        "zip5": {
          "$ref": "/schemas/common.json#/$defs/Zip5"
        },
        "vehicleId": {
          "$ref": "/schemas/common.json#/$defs/VehicleId"
        }
      },
      "required": [
        "url",
        "pageType"
      ],
      "additionalProperties": false
    },
    "ClientTurn": {
      "type": "object",
      "properties": {
        "type": {
          "const": "turn"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pageContext": {
          "$ref": "/schemas/messages.json#/$defs/PageContext"
        }
      },
      "required": [
        "type",
        "sessionId",
        "traceId",
        "message",
        "pageContext"
      ],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "/schemas/common.json#/$defs/CallId"
        },
        "name": {
          "enum": [
            "search_vehicles",
            "get_delivery_dates",
            "suggest_refinements",
            "get_vehicle_quote",
            "compare_vehicles",
            "get_owner_reviews",
            "vehicle_details",
            "find_similar",
            "present_vehicles",
            "present_comparison",
            "present_quote",
            "present_filter_suggestions"
          ]
        },
        "args": {
          "type": "object"
        },
        "render": {
          "enum": [
            "direct",
            "after_brain"
          ],
          "default": "after_brain",
          "description": "direct: Execute hands the result straight to Respond (fast path)."
        }
      },
      "required": [
        "id",
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    "ToolResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "/schemas/common.json#/$defs/CallId"
            },
            "ok": {
              "const": true
            },
            "output": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "ok",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "/schemas/common.json#/$defs/CallId"
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "/schemas/errors.json"
            }
          },
          "required": [
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ClientResults": {
      "type": "object",
      "properties": {
        "type": {
          "const": "results"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "/schemas/messages.json#/$defs/ToolResult"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "sessionId",
        "traceId",
        "results"
      ],
      "additionalProperties": false
    },
    "PresentationCall": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_vehicles"
            },
            "args": {
              "$ref": "/schemas/presentation/present_vehicles.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_comparison"
            },
            "args": {
              "$ref": "/schemas/presentation/present_comparison.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_quote"
            },
            "args": {
              "$ref": "/schemas/presentation/present_quote.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_filter_suggestions"
            },
            "args": {
              "$ref": "/schemas/presentation/present_filter_suggestions.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ToolCallEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "call": {
          "$ref": "/schemas/messages.json#/$defs/ToolCall"
        }
      },
      "required": [
        "type",
        "traceId",
        "call"
      ],
      "additionalProperties": false
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "type",
        "traceId",
        "text"
      ],
      "additionalProperties": false
    },
    "AwaitResultsEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "await_results"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "callIds": {
          "type": "array",
          "items": {
            "$ref": "/schemas/common.json#/$defs/CallId"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "traceId",
        "callIds"
      ],
      "additionalProperties": false
    },
    "AnswerEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "answer"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "text": {
          "type": "string"
        },
        "present": {
          "type": "array",
          "items": {
            "$ref": "/schemas/messages.json#/$defs/PresentationCall"
          }
        },
        "budgetReached": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "traceId",
        "text"
      ],
      "additionalProperties": false
    },
    "ErrorEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "code": {
          "enum": [
            "timeout",
            "budget_reached",
            "unauthorized",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "traceId",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ClientMessage": {
      "oneOf": [
        {
          "$ref": "/schemas/messages.json#/$defs/ClientTurn"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ClientResults"
        }
      ]
    },
    "ServerEvent": {
      "oneOf": [
        {
          "$ref": "/schemas/messages.json#/$defs/ToolCallEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ProgressEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AwaitResultsEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AnswerEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ErrorEvent"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "/schemas/messages.json#/$defs/ClientMessage"
    },
    {
      "$ref": "/schemas/messages.json#/$defs/ServerEvent"
    }
  ],
  "examples": [
    {
      "type": "turn",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "message": "AWD Model Y in the Bay Area under $40k I can get by Saturday",
      "pageContext": {
        "url": "https://www.carvana.com/cars/filters",
        "pageType": "search",
        "zip5": "94402"
      }
    },
    {
      "type": "tool_call",
      "traceId": "trace_0001abcd",
      "call": {
        "id": "call_1",
        "name": "search_vehicles",
        "args": {
          "zip5": "94402",
          "make": "Tesla",
          "model": "Model Y",
          "drive_types": [
            "Awd"
          ],
          "price_max": 40000
        }
      }
    },
    {
      "type": "progress",
      "traceId": "trace_0001abcd",
      "text": "Checking delivery dates for 24 cars…"
    },
    {
      "type": "await_results",
      "traceId": "trace_0001abcd",
      "callIds": [
        "call_1"
      ]
    },
    {
      "type": "results",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "results": [
        {
          "id": "call_1",
          "ok": false,
          "error": {
            "code": "invalid_filter_value",
            "message": "'Grey' isn't a valid color here. Valid options: Gray, Silver, White.",
            "retryable": true
          }
        }
      ]
    },
    {
      "type": "answer",
      "traceId": "trace_0001abcd",
      "text": "2 cars arrive by Saturday.",
      "present": [
        {
          "name": "present_vehicles",
          "args": {
            "rows": [
              4773662,
              4812031
            ]
          }
        }
      ]
    }
  ]
}
