{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/carvana/search.request.json",
  "title": "Carvana search request (POST /merch/search/api/v2/search)",
  "description": "Also needs headers x-cvna-ncc-disabled: false and x-cvna-sebs-srp: true, as the frontend sends them.",
  "type": "object",
  "properties": {
    "dealershipId": {
      "type": "null"
    },
    "filters": {
      "$ref": "/schemas/common.json#/$defs/Filters"
    },
    "pagination": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "const": 24
        }
      },
      "required": [
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "requestedFeatures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "sortBy": {
      "type": "string",
      "examples": [
        "MostPopular"
      ]
    },
    "zip5": {
      "$ref": "/schemas/common.json#/$defs/Zip5"
    },
    "browserCookieId": {
      "type": "string"
    },
    "analyticsData": {
      "$ref": "/schemas/common.json#/$defs/AnalyticsData"
    },
    "preferredAcquisitionName": {
      "type": "string"
    }
  },
  "required": [
    "filters",
    "pagination",
    "requestedFeatures",
    "sortBy",
    "zip5"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "dealershipId": null,
      "filters": {
        "makes": [
          {
            "name": "Tesla",
            "parentModels": [
              {
                "name": "Model Y"
              }
            ]
          }
        ],
        "driveTypes": [
          "Awd"
        ]
      },
      "pagination": {
        "page": 1,
        "pageSize": 24
      },
      "requestedFeatures": [
        "EarliestAcquisitionBoosting",
        "ExcludeFacetData",
        "HideImpossibleCombos",
        "LoanTermPricing",
        "LocationBasedPrefiltering",
        "Personalization",
        "ConditionalTiles",
        "Sprinkles",
        "ApplyTradeIn"
      ],
      "sortBy": "MostPopular",
      "zip5": "94402",
      "preferredAcquisitionName": ""
    }
  ]
}
