{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/carvana/pricing.request.json",
  "title": "Carvana quote request (POST /merch/search/api/v2/pricing/vehicle)",
  "description": "Fails with 'ClientId cannot be null' without analyticsData.clientId (phase 0).",
  "type": "object",
  "properties": {
    "vehicleId": {
      "$ref": "/schemas/common.json#/$defs/VehicleId"
    },
    "routeId": {
      "$ref": "/schemas/common.json#/$defs/RouteId"
    },
    "zip5": {
      "$ref": "/schemas/common.json#/$defs/Zip5"
    },
    "applyTradeIn": {
      "type": "boolean"
    },
    "applyVerboseLogging": {
      "type": "boolean"
    },
    "preferredAcquisitionName": {
      "type": "string"
    },
    "browserCookieId": {
      "type": "string"
    },
    "analyticsData": {
      "allOf": [
        {
          "$ref": "/schemas/common.json#/$defs/AnalyticsData"
        }
      ],
      "type": "object",
      "required": [
        "clientId"
      ],
      "properties": {
        "clientId": {
          "const": "vdp_ui"
        }
      }
    }
  },
  "required": [
    "vehicleId",
    "routeId",
    "zip5",
    "applyTradeIn",
    "analyticsData"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "applyVerboseLogging": false,
      "applyTradeIn": true,
      "browserCookieId": "00000000-0000-4000-8000-000000000001",
      "routeId": "H4sIAAAAAAAEA6tWSk_NV7IyMrA0MzHRUcrJT1ayMjY21VFKTC5RsjLSUSpLgdAFRclKVtVKyTmZSlbGBoY6SgWVuUpWhrU6SilFuUpWxmY6SmWpRWAtycUlSlZKzo5KOkrJVQVKVkqWJiYGRkq1AEx5iiVsAAAA",
      "vehicleId": 4812031,
      "zip5": "94402",
      "preferredAcquisitionName": "",
      "analyticsData": {
        "clientId": "vdp_ui",
        "correlationId": "00000000-0000-4000-8000-000000000002",
        "utmParams": {}
      }
    }
  ]
}
