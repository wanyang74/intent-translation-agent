{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/carvana/suggest.response.json",
  "title": "Carvana filter suggestions response",
  "type": "object",
  "properties": {
    "suggestedFiltersRequestId": {
      "type": "string"
    },
    "suggestedFilters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suggestionId": {
            "$ref": "/schemas/common.json#/$defs/SuggestionId"
          },
          "displayName": {
            "type": "string"
          },
          "facetKey": {
            "type": "string"
          },
          "suggestionKey": {
            "type": "string"
          },
          "totalMatchedInventory": {
            "type": "integer",
            "minimum": 0
          },
          "searchFilters": {
            "$ref": "/schemas/common.json#/$defs/Filters"
          }
        },
        "required": [
          "suggestionId",
          "displayName",
          "facetKey",
          "totalMatchedInventory",
          "searchFilters"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "suggestedFiltersRequestId",
    "suggestedFilters"
  ],
  "additionalProperties": true
}
