node_modules/
dist/
.DS_Store

# Raw recordings contain a real visitor's IDs; commit the scrubbed fixtures made from them instead
recordings/*.har

# Secrets, such as the model API key for live checks; never committed
.env
.env.*
!.env.example

# Eval runs: every trial of every run, for reading afterwards; baselines and references are committed
sites/*/evals/runs/

# Real-session traces from the local brain (personal: your messages and location); kept 30 days, never committed
traces/
# Brain logs saved with tee
logs/
