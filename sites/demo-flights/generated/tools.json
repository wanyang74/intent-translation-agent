[
  {
    "name": "search_flights",
    "description": "Search flights for a route, dates, travelers and cabin",
    "inputSchema": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "departDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "returnDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "adults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "cabin": {
          "enum": [
            "economy",
            "premium_economy",
            "business",
            "first"
          ]
        }
      },
      "required": [
        "origin",
        "destination",
        "departDate",
        "adults",
        "cabin"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_trips",
    "description": "The traveler's upcoming or past trips",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "upcoming",
            "past"
          ],
          "default": "upcoming"
        }
      },
      "additionalProperties": false
    }
  }
]
