{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/sites/carvana/schemas/tools/get_vehicle_quote.output.json",
  "title": "get_vehicle_quote: output",
  "type": "object",
  "properties": {
    "vehicleId": {
      "$ref": "/sites/carvana/schemas/common.json#/$defs/VehicleId"
    },
    "price": {
      "$ref": "/schemas/common.json#/$defs/Money"
    },
    "estimatedTaxesAndFees": {
      "$ref": "/schemas/common.json#/$defs/Money"
    },
    "estimatedTotal": {
      "$ref": "/schemas/common.json#/$defs/Money"
    },
    "option": {
      "enum": [
        "delivery",
        "pickup"
      ]
    },
    "when": {
      "type": "string"
    },
    "gapWaiver": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "available": {
              "type": "boolean"
            },
            "price": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "available",
            "price"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "vehicleId",
    "price",
    "estimatedTaxesAndFees",
    "estimatedTotal",
    "option",
    "gapWaiver"
  ],
  "additionalProperties": false,
  "description": "No monthly payment or APR in the mini version: the output schema doesn't allow them.",
  "examples": [
    {
      "vehicleId": 4812031,
      "price": 35590,
      "estimatedTaxesAndFees": 3837,
      "estimatedTotal": 39427,
      "option": "delivery",
      "when": "Saturday",
      "gapWaiver": {
        "available": true,
        "price": 1195
      }
    }
  ]
}
