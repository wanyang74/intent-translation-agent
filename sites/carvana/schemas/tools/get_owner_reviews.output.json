{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/sites/carvana/schemas/tools/get_owner_reviews.output.json",
  "title": "get_owner_reviews: output",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Written reviews Carvana has for this model and trim. Star ratings without text are counted in ratingCounts only, so its total is larger."
    },
    "ratingCounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stars": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "stars",
          "count"
        ],
        "additionalProperties": false
      },
      "description": "Star ratings from all owners, written review or not: how many gave each number of stars."
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "$ref": "/schemas/common.json#/$defs/Fenced"
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5,
            "description": "The owner's stars, 1 to 5; null when the owner wrote a review without giving stars (Carvana sends 0)."
          },
          "date": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "rating",
          "date"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "required": [
    "count",
    "reviews"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "count": 308,
      "ratingCounts": [
        {
          "stars": 5,
          "count": 727
        }
      ],
      "reviews": [
        {
          "text": "<untrusted source=\"carvana-reviews\">Comfortable to drive, constant over-the-air updates.</untrusted>",
          "rating": 5,
          "date": "2025-12-01"
        }
      ]
    }
  ]
}
