{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/sites/carvana/schemas/tools/search_vehicles.output.json",
  "title": "search_vehicles: output",
  "type": "object",
  "properties": {
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "$ref": "/sites/carvana/schemas/common.json#/$defs/VehicleId"
          },
          "stockNumber": {
            "$ref": "/sites/carvana/schemas/common.json#/$defs/StockNumber"
          },
          "year": {
            "type": "integer"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "trim": {
            "type": "string"
          },
          "mileage": {
            "type": "integer"
          },
          "color": {
            "type": "string"
          },
          "price": {
            "$ref": "/schemas/common.json#/$defs/Money"
          },
          "estimatedTaxesAndFees": {
            "$ref": "/schemas/common.json#/$defs/Money"
          },
          "estimatedTotal": {
            "$ref": "/schemas/common.json#/$defs/Money"
          },
          "locationId": {
            "type": "integer"
          },
          "deepLink": {
            "type": "string",
            "pattern": "^https://www\\.carvana\\.com/"
          }
        },
        "required": [
          "vehicleId",
          "year",
          "make",
          "model",
          "trim",
          "mileage",
          "price",
          "estimatedTaxesAndFees",
          "estimatedTotal",
          "locationId",
          "deepLink"
        ],
        "additionalProperties": false,
        "description": "No monthly payment or APR in the mini version: the output schema doesn't allow them."
      }
    },
    "totalMatches": {
      "type": "integer",
      "minimum": 0
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "searchLink": {
      "type": "string",
      "pattern": "^https://www\\.carvana\\.com/"
    },
    "nextStep": {
      "type": "string"
    }
  },
  "required": [
    "vehicles",
    "totalMatches",
    "totalPages",
    "page",
    "searchLink"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "vehicles": [
        {
          "vehicleId": 4812031,
          "stockNumber": 3006794022,
          "year": 2023,
          "make": "Tesla",
          "model": "Model Y",
          "trim": "Long Range",
          "mileage": 41533,
          "color": "Gray",
          "price": 35590,
          "estimatedTaxesAndFees": 3837,
          "estimatedTotal": 39427,
          "locationId": 300,
          "deepLink": "https://www.carvana.com/vehicle/4812031"
        }
      ],
      "totalMatches": 694,
      "totalPages": 31,
      "page": 1,
      "searchLink": "https://www.carvana.com/cars/filters?cvnaid=eyJmaWx0ZXJzIjp7Im1ha2VzIjpbeyJuYW1lIjoiVGVzbGEiLCJwYXJlbnRNb2RlbHMiOlt7Im5hbWUiOiJNb2RlbCBZIn1dfV0sImRyaXZlVHlwZXMiOlsiQXdkIl19fQ==",
      "nextStep": "To check delivery dates, call get_delivery_dates once with all the vehicle IDs."
    }
  ]
}
