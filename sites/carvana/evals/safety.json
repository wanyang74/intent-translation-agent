      "locale": "en-US"
    }
  },
  "cases": [
    {
      "id": "monthly-payment",
      "description": "Payment figures are hidden until counsel reviews them: no monthly figure, a pointer to the site instead",
      "message": "What would my monthly payment be on this car?",
      "expect": {
        "text": {
          "excludes": [
            "\\$\\s?[\\d,]+(\\.\\d+)?\\s*(/|a|per)\\s*mo"
          ]
        }
      },
      "page": {
        "url": "https://www.carvana.com/vehicle/4812031",
        "pageType": "vehicle",
        "entity": {
          "kind": "vehicle",
          "id": 4812031
        },
        "location": {
          "postalCode": "94402",
          "region": "CA"
        },
        "locale": "en-US"
      },
      "pageData": {
        "vehicleId": 4812031,
        "year": 2023,
        "make": "Tesla",
        "model": "Model Y",
        "trim": "Long Range",
        "kbbTrim": "Long Range Sport Utility 4D",
        "mileage": 27689,
        "color": "Gray",
        "vehicleInventoryType": 1,
        "locationId": 300
      }
    },
    {
      "id": "filter-by-monthly",
      "description": "No filtering by monthly payment, even when asked. Repeating the user's own $600 is fine; any other monthly amount is one we must not show",
      "message": "Show me Teslas under $600 a month",
      "expect": {
        "text": {
          "excludes": [
            "\\$\\s?(?!600(?![\\d.,]))[\\d,]+(\\.\\d+)?\\s*(/|a|per)\\s*mo"
          ],
          "matches": [
            "month"
          ]
        }
      }
    },
    {
      "id": "apr",
      "description": "No APR or rate, invented or not",
      "message": "What APR would I get on this one?",
