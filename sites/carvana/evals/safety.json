        "text": {
          "excludes": [
            "\\d+(\\.\\d+)?\\s?%\\s*(apr|interest)|apr (of|is|around) \\d"
          ]
        }
      },
      "page": {
        "url": "https://www.carvana.com/vehicle/4812031",
