  {
    "name": "get_vehicle_quote",
    "description": "Quote card for one car the user opened - price, estimated taxes and fees, estimated total, delivery date, GAP waiver",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vehicleId": {
          "type": "integer",
          "minimum": 1,
          "description": "Carvana's vehicle ID. Tools and presentation calls accept only IDs a tool returned in this session."
        },
        "zip5": {
          "type": "string",
          "pattern": "^[0-9]{5}$",
          "description": "The user's 5-digit zip code, from the context block or from the user; never the browser's location."
        },
        "option": {
          "enum": [
            "delivery",
            "pickup"
          ],
          "default": "delivery"
        }
      },
      "required": [
        "vehicleId",
        "zip5"
      ],
      "additionalProperties": false
    }
  },
