[
  {
    "name": "search_vehicles",
    "description": "Search cars for sale with filters. Returns up to 24 cars per page, each with its price, estimated taxes and fees, and estimated total, plus how many cars match and how many pages there are",
    "inputSchema": {
      "type": "object",
      "properties": {
        "zip5": {
          "type": "string",
          "pattern": "^[0-9]{5}$",
          "description": "The user's 5-digit zip code, from the context block or from the user; never the browser's location."
        },
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "trims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year_min": {
          "type": "integer"
        },
        "year_max": {
          "type": "integer"
        },
        "mileage_max": {
          "type": "integer",
          "minimum": 0
        },
        "price_max": {
          "type": "integer",
          "minimum": 0
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interior_colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drive_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body_styles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tag_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "free_delivery": {
          "type": "boolean"
        },
        "sort": {
          "type": "string",
          "default": "MostPopular"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "required": [
        "zip5"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_delivery_dates",
    "description": "Earliest delivery and pickup dates for a list of cars, in one call",
    "inputSchema": {
      "type": "object",
      "properties": {
        "vehicleIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
