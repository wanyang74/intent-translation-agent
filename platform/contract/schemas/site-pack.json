            "with_approval"
          ]
        }
      },
      "required": [
        "rateLimitPerSecond",
        "callBudget",
        "writes"
      ],
      "additionalProperties": false
    },
    "Recording": {
      "type": "object",
      "properties": {
        "hars": {
          "type": "array",
          "items": {
            "type": "string"
          },
