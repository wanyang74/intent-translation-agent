              "label"
            ],
            "additionalProperties": false
          }
        },
        "allowedValues": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Tool argument path -> where its valid values come from (an endpoint response path)."
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1
        },
        "rateLimitPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "callBudget": {
          "type": "object",
          "properties": {
            "perTask": {
              "type": "integer",
              "minimum": 1
            },
            "perSession": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "perDay": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "required": [
