{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/site-pack.json",
  "title": "Site pack manifest (sites/<id>/site.yaml)",
  "description": "Everything the platform needs to know about one site: its entities, endpoints, tools, forms, notices, policies, deep links, skills and how recordings are scrubbed. The platform never names a site; it reads this.",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "/schemas/common.json#/$defs/SiteId"
        },
        "name": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,64}$"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "/schemas/common.json#/$defs/Url"
          },
          "minItems": 1
        },
        "pages": {
          "description": "The site's pages where the agent appears, as Chrome match patterns (scheme, host, path; * matches anything). The web surface's content script runs on these.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[a-z0-9.-]+/[^\\s]*$"
          },
          "minItems": 1
        },
        "locale": {
          "$ref": "/schemas/common.json#/$defs/Locale"
        },
        "pageTypes": {
          "type": "array",
          "items": {
            "$ref": "/schemas/common.json#/$defs/PageType",
            "type": "string"
          },
          "uniqueItems": true
        },
        "requires": {
          "type": "object",
          "properties": {
            "location": {
              "enum": [
                "none",
                "postal_code"
              ]
            },
            "signIn": {
              "enum": [
                "never",
                "some_tools",
                "always"
              ]
            }
          },
          "additionalProperties": false
        },
        "brandColor": {
          "description": "The site's own button color, as #rrggbb: the panel's buttons and the user's messages use it, with white text, so it must be dark enough to read white on. Without it, the panel's neutral blue.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accountName": {
          "description": "What the site calls a signed-in person's account, such as \"Example Rewards account\": the panel names it when it asks before the agent first reads the account in a conversation. Without it, \"account\".",
          "type": "string",
          "pattern": "^[\\s\\S]{1,48}$"
        }
      },
      "required": [
        "id",
        "name",
        "origins",
        "pages"
      ],
      "additionalProperties": false
    },
    "entities": {
      "type": "object",
      "propertyNames": {
        "$ref": "/schemas/common.json#/$defs/EntityKind"
      },
      "additionalProperties": {
        "$ref": "/schemas/site-pack.json#/$defs/Entity"
      }
    },
    "endpoints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "/schemas/site-pack.json#/$defs/Endpoint"
      }
    },
    "token": {
      "type": "object",
      "description": "For sites whose frontend sends an anonymous token with every call. core.js fetches it from the site's own endpoint on the device, sends it in the header on every other call, keeps it in memory until shortly before it expires, and when a call is refused with one of refusedStatuses fetches a new one and retries once. It never reaches the brain (D1).",
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "The endpoint that issues a token. Tools don't list it in uses: the platform calls it."
        },
        "value": {
          "$ref": "/schemas/site-pack.json#/$defs/Path",
          "description": "Where the token is in that endpoint's response."
        },
        "expiresAt": {
          "$ref": "/schemas/site-pack.json#/$defs/Path",
          "description": "Where its expiry time is (an ISO date-time)."
        },
        "lifetimeSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "How long a token lasts, when the response doesn't say."
        },
        "refreshBeforeSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Fetch a new token this long before the old one expires. Default 300."
        },
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,64}$"
        },
        "format": {
          "type": "string",
          "pattern": "\\{token\\}",
          "description": "The header's value, with {token} for the token, such as \"bearer {token}\". Default \"{token}\"."
        },
        "refusedStatuses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 400,
            "maximum": 499
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Statuses that mean the token was missing, expired or refused. The first is the one the site was seen answering; FakeHost answers with it."
        }
      },
      "required": [
        "endpoint",
        "value",
        "header",
        "refusedStatuses"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "$ref": "/schemas/common.json#/$defs/ToolName"
      },
      "additionalProperties": {
        "$ref": "/schemas/site-pack.json#/$defs/Tool"
      }
    },
    "forms": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "/schemas/site-pack.json#/$defs/Form"
      }
    },
    "notices": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "/schemas/site-pack.json#/$defs/Notice"
      }
    },
    "policies": {
      "$ref": "/schemas/site-pack.json#/$defs/Policies"
    },
    "deepLinks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "description": "{name} inserts a parameter, URL-encoded; {base64json:name} inserts a parameter as JSON, base64-encoded."
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "template"
        ],
        "additionalProperties": false
      }
    },
    "destinations": {
      "type": "object",
      "description": "Pages the agent may send the user to with a Take me there button. The model names one and its parameters; core.js builds the URL, always on the site's own origins.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "What the button names, such as \"Search results on the site\"."
          },
          "description": {
            "type": "string",
            "description": "What's on the page, for the model; with no reader, all the model may say about it."
          },
          "argsOf": {
            "type": "string",
            "description": "The destination takes this tool's arguments, checked as a call to that tool would be."
          },
          "params": {
            "type": "object",
            "description": "The destination's own parameters, all required. An entity's ID must be one this session knows.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "integer"
                  ]
                },
                "entity": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "link": {
            "type": "string",
            "description": "The deep link whose template builds the URL from the parameters. Without one, the site code's destinations builder does."
          },
          "reader": {
            "type": "string",
            "description": "A tool that reads what the page shows, taking the same parameters, so the model can answer from it."
          },
          "app": {
            "type": "string",
            "description": "The app's own route for the page, a template like deep links'; apps without it open the web URL."
          },
          "pageAction": {
            "type": "string",
            "description": "One of pageActions: what the extension does on the page the button opens, such as opening the chosen item's details. The site code's builder gives its target. A destination whose action changes the site is drawn as a confirming button, with the action's consent text and the builder's summary of the item."
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "pageActions": {
      "type": "object",
      "description": "What the extension may do on the site's own page after a button in the panel, such as opening the chosen flight's details. Most only show information. One kind may change something on the site (D6): adding an item to the site's cart by pressing the site's own button, after the user pressed a confirming button that says so; never accepting terms, entering traveler details or paying. The platform runs only actions listed here; the site's page code does them, and presses nothing when it can't find its target exactly.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "What the action does on the page."
          },
          "effect": {
            "enum": [
              "shows_information",
              "changes_site_state"
            ],
            "description": "shows_information: opens or scrolls to information already on the page, and changes nothing on the site. changes_site_state: presses the site's own button that changes something there, such as adding to its cart (D6); it needs button, consent and done."
          },
          "pageTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The page types it runs on."
          },
          "button": {
            "type": "string",
            "description": "For changes_site_state: the confirming button's label, saying what pressing it does, such as \"Add to cart on the site\"."
          },
          "consent": {
            "type": "string",
            "description": "For changes_site_state: what the user agrees to by pressing it, shown above the button."
          },
          "done": {
            "type": "string",
            "description": "For changes_site_state: what the user reads once the site shows the change; {hint} is the site code's description of the item."
          }
        },
        "required": [
          "description",
          "effect",
          "pageTypes"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "load": {
            "type": "string"
          },
          "pageTypes": {
            "type": "array",
            "items": {
              "$ref": "/schemas/common.json#/$defs/PageType"
            }
          }
        },
        "required": [
          "description",
          "load"
        ],
        "additionalProperties": false
      }
    },
    "recording": {
      "$ref": "/schemas/site-pack.json#/$defs/Recording"
    },
    "notes": {
      "type": "object",
      "description": "Free-form research notes: findings, open gaps, candidate endpoints."
    }
  },
  "required": [
    "site",
    "entities",
    "endpoints",
    "tools",
    "policies",
    "recording"
  ],
  "additionalProperties": false,
  "$defs": {
    "Path": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*(:sorted)?$",
      "description": "Dotted path into a JSON value. [] maps over an array; :sorted sorts the result (for match keys)."
    },
    "SchemaRef": {
      "type": "string",
      "pattern": "^[a-z0-9_/.-]+\\.json$",
      "description": "A schema file, relative to the site's schemas folder."
    },
    "IdPath": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "/schemas/common.json#/$defs/EntityKind"
        },
        "path": {
          "$ref": "/schemas/site-pack.json#/$defs/Path"
        },
        "expiresAt": {
          "$ref": "/schemas/site-pack.json#/$defs/Path"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "Field": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,64}$"
        },
        "type": {
          "enum": [
            "money",
            "number",
            "integer",
            "text",
            "date",
            "datetime",
            "boolean",
            "duration"
          ]
        },
        "unit": {
          "type": "string"
        },
        "estimate": {
          "type": "boolean"
        },
        "from": {
          "description": "Where the value comes from: a key of the item's merged record, 'derived' (a formula), or a tool's output path (tool.path). A list names several sources in order; the first with a value is shown, for a value more than one tool returns (such as a delivery date from both a dates lookup and a quote).",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      },
      "required": [
        "label",
        "type"
      ],
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "integer",
                "string"
              ]
            },
            "pattern": {
              "type": "string"
            },
            "cardOnly": {
              "type": "boolean",
              "description": "This kind's IDs are private (such as a booking's confirmation number): they stay on the device, shown on cards, and the model gets a stand-in (withheld:<n>) that core.js swaps back."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "internal": {
          "type": "boolean",
          "description": "Never shown to the user (e.g. routing tokens)."
        },
        "noPage": {
          "type": "boolean",
          "description": "Items with no page of their own on the site, such as filter suggestions; their cards need no link."
        },
        "expires": {
          "type": "object",
          "properties": {
            "afterSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "field": {
              "$ref": "/schemas/site-pack.json#/$defs/Path"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "requiresSignIn": {
          "type": "boolean"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "/schemas/site-pack.json#/$defs/Field"
          }
        },
        "card": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "link": {
              "type": "string"
            },
            "destination": {
              "type": "string",
              "description": "A destination whose one param is this kind's ID: the card's button opens it, with the destination's page action. Takes the place of link, for items with no page of their own."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "Exact URL, or a template with {param} path segments."
        },
        "responseFormat": {
          "enum": [
            "json",
            "html",
            "sse"
          ],
          "default": "json",
          "description": "html: the response schema applies to what the site's parser extracts. sse: a stream of server-sent events, read to the end and grouped by kind (eventKind); the response schema applies to the grouped object."
        },
        "eventKind": {
          "$ref": "/schemas/site-pack.json#/$defs/Path",
          "description": "For sse: where each event's data names its kind, such as \"type\". The grouped response is {kind: [data, ...]}. Without it, the event's own name is used (\"message\" when it has none)."
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "description": "How long the host waits for the whole answer. Default 15; slow searches need more."
        },
        "request": {
          "$ref": "/schemas/site-pack.json#/$defs/SchemaRef"
        },
        "response": {
          "$ref": "/schemas/site-pack.json#/$defs/SchemaRef"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tracking": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "$ref": "/schemas/site-pack.json#/$defs/Path"
              }
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Tracking fields the endpoint requires, sent with fresh random IDs (decision D4)."
        },
        "matchKey": {
          "type": "array",
          "items": {
            "$ref": "/schemas/site-pack.json#/$defs/Path"
          },
          "description": "The request fields that decide the response. FakeHost matches fixtures on these. Empty for a request that carries nothing, such as a token endpoint's."
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "/schemas/site-pack.json#/$defs/IdPath"
          }
        },
        "signIn": {
          "type": "boolean"
        },
        "verified": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "url",
        "request",
        "response",
        "matchKey"
      ],
      "additionalProperties": false
    },
    "Tool": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "input": {
          "$ref": "/schemas/site-pack.json#/$defs/SchemaRef"
        },
        "output": {
          "$ref": "/schemas/site-pack.json#/$defs/SchemaRef"
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 1
        },
        "sideEffect": {
          "enum": [
            "read",
            "write"
          ]
        },
        "signIn": {
          "type": "boolean"
        },
        "privacy": {
          "description": "Which output fields are personal. Required for a tool that needs sign-in. personal: sent to the model, but kept out of the brain's logs, traces, session memory and saved references. cardOnly: never sent to the brain; shown on cards from the record on the device, with a stand-in (withheld:<n>) in the model's copy. Paths as in ids (trips[].route).",
          "type": "object",
          "properties": {
            "personal": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_$.\\[\\]-]{1,200}$"
              },
              "uniqueItems": true
            },
            "cardOnly": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_$.\\[\\]-]{1,200}$"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "presentation": {
          "enum": [
            "present_items",
            "present_comparison",
            "present_detail",
            "present_options",
            "present_form",
            "present_notice",
            "present_destination"
          ]
        },
        "ids": {
          "type": "object",
          "properties": {
            "input": {
              "type": "array",
              "items": {
                "$ref": "/schemas/site-pack.json#/$defs/IdPath"
              }
            },
            "output": {
              "type": "array",
              "items": {
                "$ref": "/schemas/site-pack.json#/$defs/IdPath"
              }
            }
          },
          "additionalProperties": false
        },
        "nextStep": {
          "type": "string"
        },
        "errors": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "/schemas/errors.json#/properties/code"
              },
              "message": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,}$",
                "description": "Shown to the model. {name} placeholders are filled when the error is raised. For problems core.js finds itself the standard names are tool, value, field, options, kind and id."
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "description",
        "input",
        "output",
        "uses",
        "sideEffect"
      ],
      "additionalProperties": false
    },
    "Form": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,64}$"
              },
              "type": {
                "enum": [
                  "text",
                  "date",
                  "integer",
                  "select",
                  "code"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "submitTool": {
          "$ref": "/schemas/common.json#/$defs/ToolName"
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "Notice": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,}$"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "showWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "text",
        "source"
      ],
      "additionalProperties": false,
      "description": "Approved text, shown verbatim. The model only chooses which notice applies."
    },
    "Policies": {
      "type": "object",
      "properties": {
        "hiddenFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Never shown to the user, never used to filter or rank."
        },
        "derivedFields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "formula": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,64}$"
              },
              "estimate": {
                "type": "boolean"
              },
              "appliesTo": {
