{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/messages.json",
  "title": "Messages between the client (core.js) and the agentic brain",
  "description": "Client messages are POSTed; server events stream back as newline-delimited JSON. Every message carries a trace ID.",
  "$defs": {
    "PageContext": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "/schemas/common.json#/$defs/Url"
        },
        "pageType": {
          "$ref": "/schemas/common.json#/$defs/PageType"
        },
        "entity": {
          "$ref": "/schemas/common.json#/$defs/EntityRef"
        },
        "location": {
          "$ref": "/schemas/common.json#/$defs/Location"
        },
        "locale": {
          "$ref": "/schemas/common.json#/$defs/Locale"
        },
        "signedIn": {
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "pageType"
      ],
      "additionalProperties": false
    },
    "ClientTurn": {
      "type": "object",
      "properties": {
        "type": {
          "const": "turn"
        },
        "site": {
          "$ref": "/schemas/common.json#/$defs/SiteId"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "message": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        },
        "pageContext": {
          "$ref": "/schemas/messages.json#/$defs/PageContext"
        }
      },
      "required": [
        "type",
        "site",
        "sessionId",
        "traceId",
        "message",
        "pageContext"
      ],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "/schemas/common.json#/$defs/CallId"
        },
        "name": {
          "$ref": "/schemas/common.json#/$defs/ToolName"
        },
        "args": {
          "type": "object"
        },
        "render": {
          "enum": [
            "direct",
            "after_brain"
          ],
          "default": "after_brain",
          "description": "direct: Execute hands the result straight to Respond (fast path)."
        }
      },
      "required": [
        "id",
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    "ToolResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "/schemas/common.json#/$defs/CallId"
            },
            "ok": {
              "const": true
            },
            "output": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "ok",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "/schemas/common.json#/$defs/CallId"
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "/schemas/errors.json"
            }
          },
          "required": [
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ClientResults": {
      "type": "object",
      "properties": {
        "type": {
          "const": "results"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "/schemas/messages.json#/$defs/ToolResult"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "sessionId",
        "traceId",
        "results"
      ],
      "additionalProperties": false
    },
    "PresentationCall": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_items"
            },
            "args": {
              "$ref": "/schemas/presentation/present_items.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_comparison"
            },
            "args": {
              "$ref": "/schemas/presentation/present_comparison.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_detail"
            },
            "args": {
              "$ref": "/schemas/presentation/present_detail.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_options"
            },
            "args": {
              "$ref": "/schemas/presentation/present_options.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_form"
            },
            "args": {
              "$ref": "/schemas/presentation/present_form.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_notice"
            },
            "args": {
              "$ref": "/schemas/presentation/present_notice.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ToolCallEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "call": {
          "$ref": "/schemas/messages.json#/$defs/ToolCall"
        }
      },
      "required": [
        "type",
        "traceId",
        "call"
      ],
      "additionalProperties": false
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "text": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        }
      },
      "required": [
        "type",
        "traceId",
        "text"
      ],
      "additionalProperties": false
    },
    "AwaitResultsEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "await_results"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "callIds": {
          "type": "array",
          "items": {
            "$ref": "/schemas/common.json#/$defs/CallId"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "traceId",
        "callIds"
      ],
      "additionalProperties": false
    },
    "AnswerEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "answer"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "text": {
          "type": "string"
        },
        "present": {
          "type": "array",
          "items": {
            "$ref": "/schemas/messages.json#/$defs/PresentationCall"
          }
        },
        "budgetReached": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "traceId",
        "text"
      ],
      "additionalProperties": false
    },
    "ErrorEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "code": {
          "enum": [
            "timeout",
            "budget_reached",
            "unauthorized",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "traceId",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ClientMessage": {
      "oneOf": [
        {
          "$ref": "/schemas/messages.json#/$defs/ClientTurn"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ClientResults"
        }
      ]
    },
    "ServerEvent": {
      "oneOf": [
        {
          "$ref": "/schemas/messages.json#/$defs/ToolCallEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ProgressEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AwaitResultsEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AnswerEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ErrorEvent"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "/schemas/messages.json#/$defs/ClientMessage"
    },
    {
      "$ref": "/schemas/messages.json#/$defs/ServerEvent"
    }
  ],
  "examples": [
    {
      "type": "turn",
      "site": "example-site",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "message": "Nonstop from SFO to New York on Nov 20",
      "pageContext": {
        "url": "https://www.example.com/",
        "pageType": "home",
        "locale": "en-US"
      }
    },
    {
      "type": "tool_call",
      "traceId": "trace_0001abcd",
      "call": {
        "id": "call_1",
        "name": "search_flights",
        "args": {
          "origin": "SFO",
          "destination": "JFK",
          "departDate": "2026-11-20",
          "adults": 1,
          "cabin": "economy"
        }
      }
    },
    {
      "type": "progress",
      "traceId": "trace_0001abcd",
      "text": "Searching flights for Nov 20…"
    },
    {
      "type": "await_results",
      "traceId": "trace_0001abcd",
      "callIds": [
        "call_1"
      ]
    },
    {
      "type": "results",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "results": [
        {
          "id": "call_1",
          "ok": false,
          "error": {
            "code": "invalid_value",
            "reason": "unknown_airport",
            "message": "'NYC' isn't an airport code. Use JFK, LGA or EWR.",
            "retryable": true
          }
        }
      ]
    },
    {
      "type": "answer",
      "traceId": "trace_0001abcd",
      "text": "Two nonstop flights.",
      "present": [
        {
          "name": "present_items",
          "args": {
            "entity": "flight_offer",
            "ids": [
              "off_7GQ2",
              "off_9KD1"
            ]
          }
        },
        {
          "name": "present_notice",
          "args": {
            "notice": "full_fare_rule"
          }
        }
      ]
    }
  ]
}
