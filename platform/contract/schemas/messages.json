{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intent-agent.invalid/schemas/messages.json",
  "title": "Messages between the client (core.js) and the agentic brain",
  "description": "Client messages are POSTed; server events stream back as newline-delimited JSON. Every message carries a trace ID.",
  "$defs": {
    "PageContext": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "/schemas/common.json#/$defs/Url"
        },
        "pageType": {
          "$ref": "/schemas/common.json#/$defs/PageType"
        },
        "entity": {
          "$ref": "/schemas/common.json#/$defs/EntityRef"
        },
        "location": {
          "$ref": "/schemas/common.json#/$defs/Location"
        },
        "locale": {
          "$ref": "/schemas/common.json#/$defs/Locale"
        },
        "signedIn": {
          "type": "boolean"
        },
        "pageAction": {
          "description": "What the extension did on this page after the user's last button, when its page action changes the site (D6): reported once, with the next message. The message is the one the user read.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "result": {
              "enum": [
                "done",
                "stopped",
                "unconfirmed"
              ],
              "description": "done: the site shows the change. stopped: nothing was pressed. unconfirmed: pressed, but the site didn't show the change."
            },
            "message": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,600}$"
            }
          },
          "required": [
            "action",
            "result",
            "message"
          ],
          "additionalProperties": false
        },
        "pressed": {
          "description": "The panel's buttons the user pressed since their last message, oldest first, so \"this one\" can mean the item they opened: sent once, with the next message.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PanelPress"
          },
          "minItems": 1,
          "maxItems": 5
        }
      },
      "required": [
        "url",
        "pageType"
      ],
      "additionalProperties": false
    },
    "ClientTurn": {
      "type": "object",
      "properties": {
        "type": {
          "const": "turn"
        },
        "site": {
          "$ref": "/schemas/common.json#/$defs/SiteId"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "message": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        },
        "pageContext": {
          "$ref": "/schemas/messages.json#/$defs/PageContext"
        },
        "capabilities": {
          "description": "What this device can run beyond the site's tools. Absent means none: the brain then offers only what every device has.",
          "type": "object",
          "properties": {
            "scripts": {
              "description": "The device has the platform's script sandbox, so the brain may offer run_script.",
              "type": "boolean"
            }
          },
          "required": [
            "scripts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "site",
        "sessionId",
        "traceId",
        "message",
        "pageContext"
      ],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "/schemas/common.json#/$defs/CallId"
        },
        "name": {
          "$ref": "/schemas/common.json#/$defs/ToolName"
        },
        "args": {
          "type": "object"
        },
        "render": {
          "enum": [
            "direct",
            "after_brain"
          ],
          "default": "after_brain",
          "description": "direct: Execute hands the result straight to Respond (fast path)."
        }
      },
      "required": [
        "id",
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    "ToolResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "/schemas/common.json#/$defs/CallId"
            },
            "ok": {
              "const": true
            },
            "output": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "ok",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "/schemas/common.json#/$defs/CallId"
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "/schemas/errors.json"
            }
          },
          "required": [
            "id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ClientResults": {
      "type": "object",
      "properties": {
        "type": {
          "const": "results"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "/schemas/messages.json#/$defs/ToolResult"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "sessionId",
        "traceId",
        "results"
      ],
      "additionalProperties": false
    },
    "ClientAmend": {
      "type": "object",
      "description": "A message the user sent while the turn is still running. The brain adds it to that turn, after the next tool results, instead of starting over.",
      "properties": {
        "type": {
          "const": "amend"
        },
        "sessionId": {
          "$ref": "/schemas/common.json#/$defs/SessionId"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "message": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        }
      },
      "required": [
        "type",
        "sessionId",
        "traceId",
        "message"
      ],
      "additionalProperties": false
    },
    "PresentationCall": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_items"
            },
            "args": {
              "$ref": "/schemas/presentation/present_items.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_comparison"
            },
            "args": {
              "$ref": "/schemas/presentation/present_comparison.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_detail"
            },
            "args": {
              "$ref": "/schemas/presentation/present_detail.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_options"
            },
            "args": {
              "$ref": "/schemas/presentation/present_options.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_form"
            },
            "args": {
              "$ref": "/schemas/presentation/present_form.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_notice"
            },
            "args": {
              "$ref": "/schemas/presentation/present_notice.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "present_destination"
            },
            "args": {
              "$ref": "/schemas/presentation/present_destination.json"
            }
          },
          "required": [
            "name",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ToolCallEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "call": {
          "$ref": "/schemas/messages.json#/$defs/ToolCall"
        }
      },
      "required": [
        "type",
        "traceId",
        "call"
      ],
      "additionalProperties": false
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "text": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        }
      },
      "required": [
        "type",
        "traceId",
        "text"
      ],
      "additionalProperties": false
    },
    "AwaitResultsEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "await_results"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "callIds": {
          "type": "array",
          "items": {
            "$ref": "/schemas/common.json#/$defs/CallId"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "traceId",
        "callIds"
      ],
      "additionalProperties": false
    },
    "AnswerEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "answer"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "text": {
          "type": "string"
        },
        "present": {
          "type": "array",
          "items": {
            "$ref": "/schemas/messages.json#/$defs/PresentationCall"
          }
        },
        "budgetReached": {
          "type": "boolean"
        },
        "followUps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,2000}$"
          },
          "minItems": 1,
          "description": "Messages the user sent during this turn that arrived after its last model call. The client sends them as the next turn."
        }
      },
      "required": [
        "type",
        "traceId",
        "text"
      ],
      "additionalProperties": false
    },
    "ErrorEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "code": {
          "enum": [
            "timeout",
            "budget_reached",
            "unauthorized",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "traceId",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "AmendedEvent": {
      "type": "object",
      "description": "The reply to an amend. queued: the turn will see the message at its next step. too_late: the turn has ended; send the message as a new turn.",
      "properties": {
        "type": {
          "const": "amended"
        },
        "traceId": {
          "$ref": "/schemas/common.json#/$defs/TraceId"
        },
        "status": {
          "enum": [
            "queued",
            "too_late"
          ]
        }
      },
      "required": [
        "type",
        "traceId",
        "status"
      ],
      "additionalProperties": false
    },
    "ClientMessage": {
      "oneOf": [
        {
          "$ref": "/schemas/messages.json#/$defs/ClientTurn"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ClientResults"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ClientAmend"
        }
      ]
    },
    "ServerEvent": {
      "oneOf": [
        {
          "$ref": "/schemas/messages.json#/$defs/ToolCallEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ProgressEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AwaitResultsEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AnswerEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/ErrorEvent"
        },
        {
          "$ref": "/schemas/messages.json#/$defs/AmendedEvent"
        }
      ]
    },
    "PanelPress": {
      "description": "One press of a panel button that goes to the site: a card's View on site, a Take me there, or a confirming button (D6). kind and id are the item it was for, an ID a tool returned; destination is the button's destination.",
      "type": "object",
      "properties": {
        "button": {
          "enum": [
            "card",
            "destination",
            "confirm"
          ]
        },
        "title": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$",
          "description": "What the button was for, as the panel showed it: the card's title or the destination's."
        },
        "kind": {
          "$ref": "/schemas/common.json#/$defs/EntityKind"
        },
        "id": {
          "$ref": "/schemas/common.json#/$defs/EntityId"
        },
        "destination": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "button",
        "title"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "/schemas/messages.json#/$defs/ClientMessage"
    },
    {
      "$ref": "/schemas/messages.json#/$defs/ServerEvent"
    }
  ],
  "examples": [
    {
      "type": "turn",
      "site": "example-site",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "message": "Nonstop from SFO to New York on Nov 20",
      "pageContext": {
        "url": "https://www.example.com/",
        "pageType": "home",
        "locale": "en-US"
      }
    },
    {
      "type": "tool_call",
      "traceId": "trace_0001abcd",
      "call": {
        "id": "call_1",
        "name": "search_flights",
        "args": {
          "origin": "SFO",
          "destination": "JFK",
          "departDate": "2026-11-20",
          "adults": 1,
          "cabin": "economy"
        }
      }
    },
    {
      "type": "progress",
      "traceId": "trace_0001abcd",
      "text": "Searching flights for Nov 20…"
    },
    {
      "type": "await_results",
      "traceId": "trace_0001abcd",
      "callIds": [
        "call_1"
      ]
    },
    {
      "type": "results",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "results": [
        {
          "id": "call_1",
          "ok": false,
          "error": {
            "code": "invalid_value",
            "reason": "unknown_airport",
            "message": "'NYC' isn't an airport code. Use JFK, LGA or EWR.",
            "retryable": true
          }
        }
      ]
    },
    {
      "type": "answer",
      "traceId": "trace_0001abcd",
      "text": "Two nonstop flights.",
      "present": [
        {
          "name": "present_items",
          "args": {
            "entity": "flight_offer",
            "ids": [
              "off_7GQ2",
              "off_9KD1"
            ]
          }
        },
        {
          "name": "present_notice",
          "args": {
            "notice": "full_fare_rule"
          }
        }
      ]
    },
    {
      "type": "amend",
      "sessionId": "sess_0001abcd",
      "traceId": "trace_0001abcd",
      "message": "Make it nonstop only"
    },
    {
      "type": "amended",
      "traceId": "trace_0001abcd",
      "status": "queued"
    }
  ]
}
